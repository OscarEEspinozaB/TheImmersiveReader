{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Immersive Reader",
  "mainBinaryName": "the-immersive-reader",
  "version": "0.1.0",
  "identifier": "com.immersivereader.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "The Immersive Reader",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Education",
    "shortDescription": "Read and learn vocabulary by immersion",
    "fileAssociations": [
      { "ext": ["pdf"], "mimeType": "application/pdf", "description": "PDF document" },
      { "ext": ["epub"], "mimeType": "application/epub+zip", "description": "EPUB book" },
      { "ext": ["md", "markdown"], "mimeType": "text/markdown", "description": "Markdown document" },
      { "ext": ["txt", "text"], "mimeType": "text/plain", "description": "Text document" },
      { "ext": ["tir"], "mimeType": "application/x-immersive-reader-book", "description": "Immersive Reader book" }
    ],
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": {
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"],
        "desktopTemplate": "linux/app.desktop",
        "files": { "/usr/share/mime/packages/the-immersive-reader.xml": "linux/tir-mime.xml" }
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
