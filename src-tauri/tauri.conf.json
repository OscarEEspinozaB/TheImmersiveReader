{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Immersive Reader",
  "mainBinaryName": "the-immersive-reader",
  "version": "0.1.0",
  "identifier": "com.immersivereader.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "The Immersive Reader",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Education",
    "shortDescription": "Read and learn vocabulary by immersion",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
